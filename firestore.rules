rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Connexion anonyme (provisoire) : l'identité est l'uid. Les champs `ownerEmail`, `gardenerEmail` et l'id des profils contiennent cet uid.
    function verified() {
      return request.auth != null;
    }
    function mail() {
      return request.auth.uid;
    }
    // Plus d'administrateur d'origine : un profil n'est admin que si son rôle est mis à 'admin' à la main dans la console.
    function isAdmin() {
      return verified() &&
        exists(/databases/$(database)/documents/users/$(mail())) &&
        get(/databases/$(database)/documents/users/$(mail())).data.role == 'admin';
    }
    function parcelDoc(id) {
      return get(/databases/$(database)/documents/parcelles/$(id));
    }

    // Profils : chacun crée et modifie le sien (jamais avec le rôle admin). Lecture réservée au titulaire et aux admins.
    match /users/{email} {
      allow read: if verified() && (email == mail() || isAdmin());
      allow create: if verified() && email == mail() && request.resource.data.role == 'membre';
      allow update: if verified() && ((email == mail() && request.resource.data.role == resource.data.role) || isAdmin());
      allow delete: if isAdmin();
    }

    // Annonces : visibles par tout compte connecté tant qu'elles sont publiées ; sinon par le propriétaire et le jardinier concerné.
    match /parcelles/{id} {
      allow read: if verified() && (resource.data.status == 'publiee' ||
        resource.data.ownerEmail == mail() || resource.data.gardenerEmail == mail() || isAdmin());
      allow create: if verified() && request.resource.data.ownerEmail == mail() && request.resource.data.status == 'publiee'
        && request.resource.data.gardenerEmail == '';
      allow update: if verified() && (
        // Le propriétaire modifie ou retire son annonce tant qu'elle n'est pas réservée.
        (resource.data.ownerEmail == mail() && resource.data.status != 'reservee' &&
          request.resource.data.ownerEmail == mail() && request.resource.data.status in ['publiee', 'retiree'] &&
          request.resource.data.gardenerEmail == '') ||
        // Un jardinier réserve une annonce publiée...
        (resource.data.ownerEmail != mail() && resource.data.status == 'publiee' &&
          request.resource.data.status == 'reservee' && request.resource.data.gardenerEmail == mail() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'gardenerEmail', 'updatedAt'])) ||
        // ... ou libère celle qu'il avait réservée.
        (resource.data.gardenerEmail == mail() && resource.data.status == 'reservee' &&
          request.resource.data.status == 'publiee' && request.resource.data.gardenerEmail == '' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'gardenerEmail', 'updatedAt']))
      );
      allow delete: if verified() && ((resource.data.ownerEmail == mail() && resource.data.status != 'reservee') || isAdmin());
    }

    // Adresse exacte et téléphone : propriétaire, administrateurs, et jardinier ayant payé sa réservation.
    match /adresses/{id} {
      allow read: if verified() && (resource.data.ownerEmail == mail() || isAdmin() ||
        (exists(/databases/$(database)/documents/reservations/$(id + '__' + mail())) &&
         get(/databases/$(database)/documents/reservations/$(id + '__' + mail())).data.status in ['payee', 'validee']));
      allow create: if verified() && request.resource.data.ownerEmail == mail() &&
        parcelDoc(id).data.ownerEmail == mail();
      allow update, delete: if verified() && resource.data.ownerEmail == mail();
    }

    // Réservations (paiement simulé dans la V0.1).
    match /reservations/{id} {
      function newBooking() {
        return request.resource.data.gardenerEmail == mail() &&
          id == request.resource.data.parcelId + '__' + mail() &&
          request.resource.data.status == 'payee' &&
          request.resource.data.ownerEmail != mail() &&
          parcelDoc(request.resource.data.parcelId).data.status == 'publiee' &&
          parcelDoc(request.resource.data.parcelId).data.ownerEmail == request.resource.data.ownerEmail &&
          request.resource.data.price == parcelDoc(request.resource.data.parcelId).data.pricePerYear;
      }
      allow read: if verified() && (resource.data.gardenerEmail == mail() || resource.data.ownerEmail == mail() || isAdmin());
      allow create: if verified() && newBooking();
      allow update: if verified() && (
        // Le propriétaire valide avec le code remis au jardinier après la première rencontre...
        (resource.data.ownerEmail == mail() && resource.data.status == 'payee' && request.resource.data.status == 'validee' &&
          request.resource.data.codeEntered == get(/databases/$(database)/documents/codes/$(id)).data.code &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'codeEntered', 'validatedAt'])) ||
        // ... puis demande les versements.
        (resource.data.ownerEmail == mail() && resource.data.status == 'validee' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['payoutsRequested'])) ||
        // Le jardinier annule tant que le code n'est pas validé.
        (resource.data.gardenerEmail == mail() && resource.data.status == 'payee' && request.resource.data.status == 'annulee' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledAt'])) ||
        // Il peut re-réserver une annonce qu'il avait annulée.
        (resource.data.gardenerEmail == mail() && resource.data.status == 'annulee' && newBooking())
      );
    }

    // Troc de plantes : dons gratuits visibles par tout membre connecté tant qu'ils sont disponibles ; sinon par le donateur.
    match /plantes/{id} {
      allow read: if verified() && (resource.data.status == 'disponible' || resource.data.ownerEmail == mail() || isAdmin());
      allow create: if verified() && request.resource.data.ownerEmail == mail() && request.resource.data.status == 'disponible';
      allow update: if verified() && resource.data.ownerEmail == mail() && request.resource.data.ownerEmail == mail() &&
        request.resource.data.status in ['disponible', 'donne'];
      allow delete: if verified() && (resource.data.ownerEmail == mail() || isAdmin());
    }

    // « À cueillir » : offres gratuites (fruits, aromatiques...) visibles par tout membre connecté tant qu'elles sont ouvertes ; sinon par le propriétaire.
    match /cueillettes/{id} {
      allow read: if verified() && (resource.data.status == 'ouverte' || resource.data.ownerEmail == mail() || isAdmin());
      allow create: if verified() && request.resource.data.ownerEmail == mail() && request.resource.data.status == 'ouverte';
      allow update: if verified() && resource.data.ownerEmail == mail() && request.resource.data.ownerEmail == mail() &&
        request.resource.data.status in ['ouverte', 'fermee'];
      allow delete: if verified() && (resource.data.ownerEmail == mail() || isAdmin());
    }

    // Saisies de récolte (kg par culture) : lisibles par leur auteur et par le propriétaire du jardin.
    // Création : par le propriétaire ou le jardinier d'une parcelle, ou par le propriétaire d'une offre « à cueillir » ; poids borné.
    match /recoltes/{id} {
      allow read: if verified() && (resource.data.authorEmail == mail() || resource.data.ownerEmail == mail() || isAdmin());
      allow create: if verified() && request.resource.data.authorEmail == mail() &&
        request.resource.data.kg is number && request.resource.data.kg > 0 && request.resource.data.kg <= 500 &&
        request.resource.data.kind in ['fruit', 'legume', 'aromatique', 'autre'] &&
        ((request.resource.data.sourceType == 'parcelle' &&
          parcelDoc(request.resource.data.sourceId).data.ownerEmail == request.resource.data.ownerEmail &&
          (parcelDoc(request.resource.data.sourceId).data.ownerEmail == mail() || parcelDoc(request.resource.data.sourceId).data.gardenerEmail == mail())) ||
         (request.resource.data.sourceType == 'cueillette' &&
          request.resource.data.ownerEmail == mail() &&
          get(/databases/$(database)/documents/cueillettes/$(request.resource.data.sourceId)).data.ownerEmail == mail()));
      allow delete: if verified() && (resource.data.authorEmail == mail() || isAdmin());
    }

    // Compteurs publics de l'accueil : un document par mois (AAAA-MM), kilos par type et nombre de saisies, sans donnée personnelle.
    // Lecture ouverte à tous (même sans connexion). Écriture : un compte connecté, par pas de 500 kg au plus.
    // LIMITE connue de la V0.1 : le client écrit lui-même ces compteurs ; à déplacer dans une fonction serveur avec le vrai paiement.
    match /stats/{month} {
      function statKeys() {
        return request.resource.data.keys().hasOnly(['fruit', 'legume', 'aromatique', 'autre', 'count']);
      }
      allow read: if true;
      allow create: if verified() && month.matches('^[0-9]{4}-(0[1-9]|1[0-2])$') && statKeys() &&
        request.resource.data.fruit >= 0 && request.resource.data.fruit <= 500 &&
        request.resource.data.legume >= 0 && request.resource.data.legume <= 500 &&
        request.resource.data.aromatique >= 0 && request.resource.data.aromatique <= 500 &&
        request.resource.data.autre >= 0 && request.resource.data.autre <= 500 &&
        request.resource.data.count >= 0 && request.resource.data.count <= 1;
      allow update: if verified() && statKeys() &&
        request.resource.data.fruit >= 0 && request.resource.data.fruit - resource.data.fruit <= 500 && resource.data.fruit - request.resource.data.fruit <= 500 &&
        request.resource.data.legume >= 0 && request.resource.data.legume - resource.data.legume <= 500 && resource.data.legume - request.resource.data.legume <= 500 &&
        request.resource.data.aromatique >= 0 && request.resource.data.aromatique - resource.data.aromatique <= 500 && resource.data.aromatique - request.resource.data.aromatique <= 500 &&
        request.resource.data.autre >= 0 && request.resource.data.autre - resource.data.autre <= 500 && resource.data.autre - request.resource.data.autre <= 500 &&
        request.resource.data.count >= 0 && request.resource.data.count - resource.data.count <= 1 && resource.data.count - request.resource.data.count <= 1;
    }

    // Code de validation : lisible par le seul jardinier (le propriétaire ne le connaît qu'après la rencontre).
    match /codes/{id} {
      allow read: if verified() && resource.data.gardenerEmail == mail();
      allow create: if verified() && request.resource.data.gardenerEmail == mail() &&
        id == request.resource.data.parcelId + '__' + mail();
      allow update: if verified() && resource.data.gardenerEmail == mail() && request.resource.data.gardenerEmail == mail();
    }

    // TEMPORAIRE (test) : annonces et adresses ouvertes à tous, y compris sans connexion. À SUPPRIMER avant toute mise en production.
    match /parcelles/{id} {
      allow read, write: if true;
    }
    match /adresses/{id} {
      allow read, write: if true;
    }
  }
}
